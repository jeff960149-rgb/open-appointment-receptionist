# Free local booking demo works with these values unchanged.
BUSINESS_CONFIG=examples/generic.json
DATA_DIR=data
ENABLE_DEMO=true

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Optional AI voice/text. Set a model your own account can access.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
MAX_CALL_SECONDS=600

# Optional Twilio: public HTTPS origin, no trailing slash.
PUBLIC_BASE_URL=
TWILIO_AUTH_TOKEN=
HUMAN_FORWARD_NUMBERS=
HUMAN_SIP_URIS=
HUMAN_ONLY_CALLER_NUMBERS=
HUMAN_RING_SECONDS=20
AI_FALLBACK_ENABLED=false

# Optional Telegram staff alerts and capacity/AI commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
